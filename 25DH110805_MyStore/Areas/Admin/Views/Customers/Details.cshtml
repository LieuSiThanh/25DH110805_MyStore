@model _25DH110805_MyStore.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px; color: white;">CHI TIẾT THÔNG TIN KHÁCH HÀNG</h2>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>Tên khách hàng:</dt>
        <dd>@Html.DisplayFor(model => model.CustomerName)</dd>

        <dt>Tên đăng nhập:</dt>
        <dd>@Html.DisplayFor(model => model.Username)</dd>

        <dt>Số điện thoại:</dt>
        <dd>@Html.DisplayFor(model => model.CustomerPhone)</dd>

        <dt>Email:</dt>
        <dd>@Html.DisplayFor(model => model.CustomerEmail)</dd>

        <dt>Địa chỉ:</dt>
        <dd>@Html.DisplayFor(model => model.CustomerAddress)</dd>
    </dl>
</div>

<h3 style="margin-top: 30px;">Lịch sử đơn hàng của khách hàng này</h3>
<table class="table table-bordered table-striped">
    <tr class="bg-warning">
        <th>Mã đơn hàng</th>
        <th>Ngày đặt</th>
        <th>Tổng tiền</th>
        <th>Trạng thái thanh toán</th>
        <th>Địa chỉ giao hàng</th>
    </tr>
    @if (Model.Order != null && Model.Order.Any())
    {
        foreach (var order in Model.Order)
        {
            <tr>
                <td>@order.OrderID</td>
                <td>@order.OrderDate</td>
                <td>@string.Format("{0:N0} VNĐ", order.TotalAmount)</td>
                <td>@order.PaymentStatus</td>
                <td>@order.AddressDelivery</td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="5" class="text-center text-muted">Khách hàng này chưa có đơn hàng nào trong hệ thống.</td>
        </tr>
    }
</table>

<p style="margin-top: 20px;">
    @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
</p>