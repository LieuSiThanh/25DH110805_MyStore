@model IEnumerable<_25DH110805_MyStore.Models.Product>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Danh sánh sản phẩm</h2>
<table class="bg-success col-lg-12 col-md-4 col-sm-2">
    <tr>
        <th class="bg-success col-lg-8 col-md-4 col-sm-2">
            Tên Sản Phẩm
        </th>
        <th class="bg-success col-lg-8 col-md-4 col-sm-2">
            Hình ảnh Sản Phẩm
        </th>
        <th class="bg-success col-lg-8 col-md-4 col-sm-2">
            Giá Sản Phẩm
        </th>
        <th class="bg-success col-lg-8 col-md-4 col-sm-2">
            Danh mục Sản Phẩm
        </th>
        <th class="bg-success col-lg-8 col-md-4 col-sm-2"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductImage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Cập Nhật", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Chi Tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
            </td>
        </tr>
    }

</table>
<p>@Html.ActionLink("thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })</p>

