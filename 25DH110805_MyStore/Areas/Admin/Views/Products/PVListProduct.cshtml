@model _25DH110805_MyStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;

<p style="margin-top: 15px; margin-bottom: 15px;">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary btn-sm" })
</p>

<table class="table table-bordered table-hover">
    <thead class="bg-info text-white">
        <tr>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Đơn giá</th>
            <th>Danh mục</th>
            <th style="width: 220px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Products != null && Model.Products.Any())
        {
            foreach (var product in Model.Products)
            {
                <tr>
                    <td class="text-center">
                        <img src="@Url.Content(product.ProductImage)" style="height:100px; max-width:100px; object-fit: cover;" />
                    </td>
                    <td>@Html.DisplayFor(modelItem => product.ProductName)</td>
                    <td>@string.Format("{0:N0}", product.ProductPrice) đ</td>
                    <td>@Html.DisplayFor(modelItem => product.Category.CategoryName)</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-info btn-sm text-white" }) |
                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-danger font-weight-bold" style="padding: 20px;">
                    KHÔNG TÌM THẤY SẢN PHẨM NÀO PHÙ HỢP
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-center" style="margin-top: 20px;">
    @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))
</div>