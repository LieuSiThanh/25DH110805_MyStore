@model _25DH110805_MyStore.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .pro {
            padding: 50px 10px;
            background-color: ghostwhite;
        }

        .pro-section {
            background-color: white;
            border: 1px groove #ffffff;
            border-radius: 10px;
            margin: 10px;
        }

            .pro-section img {
                max-height: 250px;
                max-width: 200px;
                padding: 5px;
            }

        .pro-price {
            font-weight: bolder;
            font-size: larger;
            color: red;
        }

        .pro-sale {
            font-weight: lighter;
        }
    </style>
</head>

<div class="container-fluid pro">
    <div class="row">
        <div class="col-md-3 pro-section text-center">
            <img src="@Model.product.ProductImage" alt="@Model.product.ProductName" />
        </div>

        <div class="col-md-5 pro-section">
            <div>
                <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
                <p class="pro-sale">Đã bán:&nbsp;@Model.product.OrderDetail.Count</p>
                <p class="pro-price">@Model.product.ProductPrice.ToString("N0") VNĐ</p>
                <p>Danh mục:&nbsp;@Model.product.Category.CategoryName</p>
                <hr />
                <h5><strong>Mô tả</strong></h5>
                <p>@Model.product.ProductDescription</p>
            </div>
            <hr />
            <div>
                @Html.Partial("_PVRelatedProduct", Model)
            </div>
        </div>

        <div class="col-md-3 pro-section">
            <div class="form-group">
                @using (Html.BeginForm("ProductDetail", "Home", FormMethod.Get))
                {
                    @Html.Hidden("id", Model.product.ProductID)
                    <h4><strong>Số lượng</strong></h4>
                    <p>
                        @Html.TextBoxFor(model => model.quantity, new { @class = "form-control", @type = "number", @min = "1" })
                    </p>
                    <h4><strong>Tạm tính</strong></h4>
                    <p>@Model.estimatedValue.ToString("N0") VNĐ</p>
                    <p>
                        @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                            new { id = Model.product.ProductID, quantity = Model.quantity },
                            new { @class = "btn btn-info" })
                    </p>
                }
            </div>
            <hr />
            <div>
                @Html.Partial("_PVTopProduct", Model)
            </div>
        </div>
    </div>
</div>