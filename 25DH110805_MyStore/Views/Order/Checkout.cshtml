@model _25DH110805_MyStore.Models.ViewModel.CheckoutVM
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<script>
    function enableAddressEdit() {
        document.getElementById("ShippingAddress").removeAttribute("readonly");
        document.getElementById("newAddressGroup").style.display = "block";
    }

    function updateShippingAddress() {
        var newAddress = document.getElementById("newShippingAddress").value;
        if (newAddress && newAddress.trim() !== "") {
            document.getElementById("ShippingAddress").value = newAddress;
        }
    }
</script>

<h2>ĐẶT HÀNG</h2>

@using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()

    <h3>Thông tin đơn hàng</h3>
    <div class="form-group">
        <table class="table">
            <thead>
                <tr>
                    <th colspan="2">Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.CartItems != null)
                {
                    foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td><img src="@item.CategoryImage" style="max-height:60px;" alt="" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                            <td>@item.TotalPrice.ToString("N0") VNĐ</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <h3>Thông tin giao hàng</h3>
    <div class="form-group">
        @Html.TextBox("ShippingAddress", Model.ShippingAddress, new { @class = "form-control", @readonly = "readonly", id = "ShippingAddress" })
        <div class="col-md-10">
            @Html.ValidationMessage("ShippingAddress", "", new { @class = "text-danger" })
            @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })
            <button type="button" class="btn btn-link" onclick="enableAddressEdit()">Chỉnh sửa địa chỉ</button>
        </div>
    </div>

    <div class="form-group" id="newAddressGroup" style="display:none;">
        @Html.Label("Địa chỉ mới", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" id="newShippingAddress" class="form-control" placeholder="Nhập địa chỉ giao hàng mới..." />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("Phương thức giao hàng", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <label>@Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng nhanh", new { @checked = "checked" }) Giao hàng nhanh</label><br />
            <label>@Html.RadioButtonFor(m => m.ShippingMethod, "Giao hàng tiết kiệm") Giao hàng tiết kiệm</label>
        </div>
    </div>

    <div class="form-group">
        @Html.Label("Phương thức thanh toán", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <label>@Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt", new { @checked = "checked" }) Tiền mặt</label><br />
            <label>@Html.RadioButtonFor(m => m.PaymentMethod, "Paypal") Paypal</label><br />
            <label>@Html.RadioButtonFor(m => m.PaymentMethod, "Mua trước trả sau") Mua trước trả sau</label>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.TotalAmount, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.TotalAmount, new { @class = "form-control", @readonly = "readonly", @Value = Model.TotalAmount.ToString("N0") + " VNĐ" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Đặt hàng" class="btn btn-danger" onclick="updateShippingAddress()" />
        </div>
    </div>
}