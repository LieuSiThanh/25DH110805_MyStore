@model _25DH110805_MyStore.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="margin-top: 30px;">
    <h2>CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <h4>Thông tin giao hàng</h4>
            <p><strong>Ngày đặt:</strong> @(Model.OrderDate.ToString("dd/MM/yyyy HH:mm"))</p>
            <p><strong>Địa chỉ nhận:</strong> @Model.ShippingAddress</p>
            <p><strong>Phương thức giao:</strong> @Model.DeliveryMethod</p>
            <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
            <p><strong>Trạng thái thanh toán:</strong> <span class="text-danger">@Model.PaymentStatus</span></p>
        </div>
    </div>

    <h4 style="margin-top: 30px;">Danh sách sản phẩm</h4>
    <table class="table table-bordered">
        <thead>
            <tr class="active">
                <th>Sản phẩm</th>
                <th>Hình ảnh</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetail)
            {
                <tr>
                    <td>@(item.Product != null ? item.Product.ProductName : "Sản phẩm")</td>
                    <td>
                        @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ProductImage))
                        {
                         <img src="@item.Product.ProductImage" style="width: 50px; height: 50px; object-fit: contain;" />
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>@(item.UnitPrice.ToString("N0")) VNĐ</td>
                    <td>@item.TotalPrice</td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="text-right text-danger">
        Tổng giá trị: @(Model.TotalAmount.ToString("N0")) VNĐ
    </h3>

    <div style="margin-top: 20px;">
        <a href="@Url.Action("MyOrder", "Order")" class="btn btn-default"><i class="fas fa-arrow-left"></i> Quay lại lịch sử đơn hàng</a>
    </div>
</div>