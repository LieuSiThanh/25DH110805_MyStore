@using _25DH110805_MyStore.Models
@{
    int totalQuantity = 0;
    bool isLoggedIn = Request.IsAuthenticated || Session["Username"] != null;
    string username = Session["Username"] != null ? Session["Username"].ToString() : (User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty);

    if (isLoggedIn)
    {
        using (var db = new MyStoreEntities())
        {
            int customerId = 0;
            if (Session["CustomerID"] != null)
            {
                int.TryParse(Session["CustomerID"].ToString(), out customerId);
            }
            else if (!string.IsNullOrEmpty(username))
            {
                var cust = db.Customer.FirstOrDefault(c => c.Username == username);
                if (cust != null)
                {
                    customerId = cust.CustomerID;
                    Session["CustomerID"] = customerId;
                }
            }

            if (customerId > 0)
            {
                var cartInDb = db.Cart.Where(c => c.CustomerID == customerId);
                if (cartInDb.Any())
                {
                    totalQuantity = cartInDb.Sum(c => (int)c.Quantity);
                }
            }
        }
    }

    ViewBag.pmmodel = new _25DH110805_MyStore.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = isLoggedIn,
        Username = username,
        CartCount = totalQuantity
    };
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Ethie Store</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

    <style>
        body {
            padding-top: 100px;
        }

        .freeship-bar {
            background-color: #55e670;
            color: #000;
            text-align: center;
            padding: 6px 0;
            font-weight: bold;
            font-style: italic;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1031;
        }

        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid #e7e7e7;
            position: fixed;
            top: 31px;
            left: 0;
            right: 0;
            z-index: 1030;
            margin-bottom: 0;
            border-radius: 0;
        }

        .navbar-brand img {
            max-height: 35px;
            display: inline-block;
        }

        .nav-personal {
            display: flex !important;
            align-items: center;
            flex-direction: row;
        }

            .nav-personal > li {
                float: none !important;
                display: inline-block !important;
            }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            right: 0;
            background-color: #ffffff;
            min-width: 180px;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.15);
            border-radius: 4px;
            padding: 5px 0;
            list-style: none;
            z-index: 1000;
        }

        .dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-menu-custom li a {
            color: #333;
            padding: 8px 16px;
            display: block;
            text-decoration: none;
        }

            .dropdown-menu-custom li a:hover {
                background-color: #f5f5f5;
                color: #d9534f;
            }

        .cart-badge {
            background-color: #d9534f;
            color: white;
            border-radius: 50%;
            padding: 2px 7px;
            font-size: 12px;
            margin-left: 3px;
        }
        .thumbnail img, .product-item img, .card-img-top {
            width: 100% !important;
            height: 220px !important;
            object-fit: contain !important;
        }

        footer {
            background-color: #e0e0e0;
            padding: 20px 0;
            margin-top: 40px;
            border-top: 1px solid #ccc;
        }
    </style>
</head>
<body>

    <div class="freeship-bar">
        Free ship đơn từ 40k, giảm nhiều hơn cùng <span style="color: blue; font-style: normal;">FREESHIP XTRA</span>
    </div>

    <div class="navbar navbar-default navbar-custom" style="padding: 0 15px;">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center; width: 100%; max-width: 100%; padding: 0;">

            <div class="navbar-header" style="float: none; margin: 0;">
                <a href="@Url.Action("Index", "Home")" class="navbar-brand" style="height: auto; padding: 10px 0; display: flex; align-items: center;">
                    <strong style="font-size: 24px; color: #333; letter-spacing: 2px;">Ethie</strong>
                </a>
            </div>

            <div style="float: none;">
                <ul class="nav navbar-nav navbar-right nav-personal" style="display: flex; align-items: center; margin: 0; list-style: none;">
                    <li style="float: none;">
                        <a href="@Url.Action("Index", "Home")" style="display: flex; align-items: center; gap: 5px; padding: 15px 12px; color: #333; text-decoration: none; font-weight: 600;">
                            <i class="fas fa-home"></i> Trang chủ
                        </a>
                    </li>

                    <li class="dropdown" style="float: none; position: relative;">
                        <a href="javascript:void(0)" class="dropdown-toggle" style="display: flex; align-items: center; gap: 5px; padding: 15px 12px; color: #333; text-decoration: none; font-weight: 600;">
                            <i class="fas fa-user"></i>
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <span>Chào, @ViewBag.pmmodel.Username</span>
                            }
                            else
                            {
                                <span>Tài khoản</span>
                            }
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu-custom">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <li><a href="@Url.Action("Details", "Customer", new { id = Session["CustomerID"] })">Thông tin tài khoản</a></li>
                                <li><a href="@Url.Action("MyOrder", "Order")"><i class="fas fa-shopping-bag"></i> Lịch sử mua hàng</a></li>
                                <li class="divider" style="height:1px; background:#eee; margin:5px 0;"></li>
                                <li><a href="@Url.Action("Logout", "Customer")"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action("Register", "Customer")"><i class="fas fa-user-plus"></i> Đăng ký</a></li>
                                <li><a href="@Url.Action("Login", "Customer")"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a></li>
                            }
                        </ul>
                    </li>
                    @if (ViewBag.pmmodel.IsLoggedIn) { 
                        <li style="float: none;">
                            <a href="@Url.Action("Index", "Cart")" style="display: flex; align-items: center; gap: 5px; padding: 15px 12px; color: #333; text-decoration: none; font-weight: 600;">
                                <i class="fas fa-shopping-cart"></i> Giỏ hàng
                                <span class="cart-badge">@ViewBag.pmmodel.CartCount</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="container body-content" style="min-height: 500px;">
        @RenderBody()
    </div>

    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p>&copy; @DateTime.Now.Year - Website Bán Hàng ASP.NET MVC5</p>
                </div>
                <div class="col-md-6 text-right">
                    <p><strong>Contact:</strong> Liều Sì Thanh</p>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>