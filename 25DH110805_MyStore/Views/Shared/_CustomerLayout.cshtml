@using _25DH110805_MyStore.Models.ViewModel
@{
    var cart = Session["Cart"] as Cart;

    ViewBag.pmmodel = new PersonalMenuVM
    {
        IsLoggedIn = Request.IsAuthenticated || Session["Username"] != null,
        Username = Session["Username"] != null ? Session["Username"].ToString() : (User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty),
        CartCount = 0
    };

    if (cart != null && cart.Items != null && cart.Items.Any())
    {
        ViewBag.pmmodel.CartCount = cart.Items.Sum(i => i.Quantity);
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FASTOR Store</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

    <style>
        body {
            padding-top: 100px;
        }

        .freeship-bar {
            background-color: #55e670;
            color: #000;
            text-align: center;
            padding: 6px 0;
            font-weight: bold;
            font-style: italic;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1031;
        }

        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid #e7e7e7;
            position: fixed;
            top: 31px;
            left: 0;
            right: 0;
            z-index: 1030;
            margin-bottom: 0;
            border-radius: 0;
        }

        .navbar-brand img {
            max-height: 35px;
            display: inline-block;
        }

        .nav-personal > li {
            display: inline-block;
            float: left;
        }

            .nav-personal > li > a {
                color: #333 !important;
                font-weight: 600;
                padding: 15px 12px;
            }

        .dropdown-menu-custom {
            display: none;
            position: absolute;
            right: 0;
            background-color: #ffffff;
            min-width: 180px;
            box-shadow: 0px 8px 16px rgba(0,0,0,0.15);
            border-radius: 4px;
            padding: 5px 0;
            list-style: none;
            z-index: 1000;
        }

        .dropdown:hover .dropdown-menu-custom {
            display: block;
        }

        .dropdown-menu-custom li a {
            color: #333;
            padding: 8px 16px;
            display: block;
            text-decoration: none;
        }

            .dropdown-menu-custom li a:hover {
                background-color: #f5f5f5;
                color: #d9534f;
            }

        .cart-badge {
            background-color: #d9534f;
            color: white;
            border-radius: 50%;
            padding: 2px 7px;
            font-size: 12px;
            margin-left: 3px;
        }

        footer {
            background-color: #e0e0e0;
            padding: 20px 0;
            margin-top: 40px;
            border-top: 1px solid #ccc;
        }
    </style>
</head>
<body>

    <div class="freeship-bar">
        Free ship đơn từ 40k, giảm nhiều hơn cùng <span style="color: blue; font-style: normal;">FREESHIP XTRA</span>
    </div>

    <div class="navbar navbar-default navbar-custom">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="@Url.Action("Index", "Home")" class="navbar-brand">
                    <strong style="font-size: 24px; color: #333; letter-spacing: 2px;">FASTOR</strong>
                </a>
            </div>

            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav navbar-right nav-personal">
                    <li>
                        <a href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home"></i> Trang chủ
                        </a>
                    </li>

                    <li class="dropdown" style="position: relative;">
                        <a href="javascript:void(0)" class="dropdown-toggle">
                            <i class="fas fa-user"></i>
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <span>Chào, @ViewBag.pmmodel.Username</span>
                            }
                            else
                            {
                                <span>Tài khoản</span>
                            }
                            <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu-custom">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <li><a href="@Url.Action("ProfileInfo", "Account")"><i class="fas fa-id-card"></i> Thông tin tài khoản</a></li>
                                <li><a href="@Url.Action("MyOrder", "Order")"><i class="fas fa-shopping-bag"></i> Lịch sử mua hàng</a></li>
                                <li class="divider" style="height:1px; background:#eee; margin:5px 0;"></li>
                                <li><a href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                            }
                            else
                            {
                                <li><a href="@Url.Action("Register", "Account")"><i class="fas fa-user-plus"></i> Đăng ký</a></li>
                                <li><a href="@Url.Action("Login", "Account")"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a></li>
                            }
                        </ul>
                    </li>

                    <li>
                        <a href="@Url.Action("Index", "Cart")">
                            <i class="fas fa-shopping-cart"></i> Giỏ hàng
                            <span class="cart-badge">@ViewBag.pmmodel.CartCount</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="container body-content" style="min-height: 500px;">
        @RenderBody()
    </div>

    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p>&copy; @DateTime.Now.Year - Website Bán Hàng ASP.NET MVC5</p>
                </div>
                <div class="col-md-6 text-right">
                    <p><strong>Contact:</strong> Thành viên thực hiện dự án</p>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>